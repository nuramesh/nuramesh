{
  "name": "@nuramesh/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "NuraMesh TypeScript SDK for the NuraMesh API, generated from the server's OpenAPI schema.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "gen": "node scripts/generate.mjs",
    "gen:check": "node scripts/generate.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
