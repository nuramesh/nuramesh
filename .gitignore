# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
# the built web app, copied in by scripts/release/build_web.py for a release build (ND394)
src/nuramesh/web/
*.egg-info
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Secrets and local settings: never commit
.env
.env.*
!.env.example

# OS and editors
.DS_Store
.idea/
.vscode/

# Node / Next.js build output (any app under apps/)
node_modules/
.next/
out/

# Terraform: state can contain secrets; never commit it
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
*.tfplan

# Local run stores (ledger and state) of team folders
.nuramesh/
.nuramesh/

# Backstop: SSH private keys never enter Git (anchors deploy key lives in ~/.ssh)
*_ed25519

# Saved Terraform plans can hold secrets (ND49)
tfplan
*.db-shm
*.db-wal


# R1.29 Compose stack: generated secrets and local settings never go to Git
deploy/compose/secrets/
deploy/compose/.env
*.key
pytest-output.txt
