# The example settings (named `env.example`, not `.env.example`, so it is never mistaken for a live
# dotenv file). Copy to `.env` (git-ignored) and edit:
#   cp deploy/compose/env.example deploy/compose/.env
# Names and non-secret values only: secrets are files in secrets/, made by
# `sh deploy/compose/init-secrets.sh`.

# Image tag of the locally built nuramesh-api, nuramesh-worker and nuramesh-web images.
NURAMESH_COMPOSE_IMAGE_TAG=local

# The database name inside the stack's Postgres (the role names are fixed).
NURAMESH_DB_NAME=nuramesh

# The team configuration folder, an ABSOLUTE path (create it with `nuramesh init`). Read-only in the stack.
NURAMESH_COMPOSE_TEAM_PATH=

# The one published port, on 127.0.0.1 only. The browser URL is https://127.0.0.1:<WEB_PORT>.
WEB_PORT=8443

# Engine (ND399 OD-3): runs execute on the built-in light engine (the `runner` service): one runner
# per database, no horizontal scaling, no automatic failover. Temporal is opt-in: uncomment to also
# start its worker and dev server (evaluation only), or pass `--profile temporal` to compose.
# COMPOSE_PROFILES=temporal
NURAMESH_TEMPORAL_NAMESPACE=default
NURAMESH_TEMPORAL_TASK_QUEUE=nuramesh

# Optional local-model profile (ND266, docs/self-hosting.md): qwen3:8b (default, about 5.2 GB) or
# qwen3:4b (low RAM, about 2.5 GB). Chooses what the by-hand `ollama-pull` step downloads AND what
# the ollama service verifies and waits for; `nuramesh models local-model --model` is separate, so
# keep the two the same.
NURAMESH_LOCAL_MODEL=qwen3:8b

# The host's region for the local model (ND266): where this machine processes data. `canada`,
# `global` (synthetic data only) or `region:<id>`. Read by `nuramesh models local-model`, which
# refuses to guess; leave empty if you do not use the profile.
NURAMESH_LOCAL_MODEL_PROCESSING=

# Backup acknowledgement for the `migrate` service (see docs/upgrade-notes.md). Leave empty.
# When `nuramesh db migrate --plan` lists a NOT ADDITIVE migration, take the backup, stop api and
# worker, then set this to the highest pending migration number and run `docker compose up -d`.
# Clear it again afterwards.
NURAMESH_MIGRATE_ACK=
